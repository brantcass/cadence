# --- Model provider ---
LLM_PROVIDER=claude          # claude | kimi
ANTHROPIC_API_KEY=your_key_here
# MOONSHOT_API_KEY=your_key_here   # only if LLM_PROVIDER=kimi

# --- Garmin (optional; leave USE_LIVE_GARMIN=false to use sample data) ---
USE_LIVE_GARMIN=false
# GARMIN_EMAIL=you@example.com
# GARMIN_PASSWORD=your_password
# Garmin doesn't expose a running threshold pace through the wrapper. Set it
# here (decimal min/km, e.g. 4.55 == 4:33/km) to enable pace-zone features on
# live data; leave unset and the coach just skips zone advice.
# GARMIN_THRESHOLD_PACE=4.55
