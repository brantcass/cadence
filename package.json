{
  "name": "cadence",
  "version": "0.1.0",
  "private": true,
  "description": "Run the Cadence backend (FastAPI) and frontend (Vite) together.",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c cyan,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && .venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
